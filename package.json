{
  "name": "disclose-io-hugo",
  "version": "1.0.0",
  "description": "disclose.io website built with Hugo and Tailwind CSS",
  "scripts": {
    "dev": "npm run prebuild && npm-run-all --parallel dev:*",
    "dev:hugo": "hugo server --buildDrafts --buildFuture",
    "dev:css": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --watch",
    "prebuild": "node scripts/preprocess-framework.js",
    "build": "npm-run-all prebuild build:css build:hugo build:search",
    "build:css": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --minify",
    "build:hugo": "hugo --minify",
    "build:search": "npx pagefind --site public",
    "preview": "hugo server --buildDrafts --buildFuture --port 1313",
    "framework:build": "node scripts/preprocess-framework.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.2",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.3"
  },
  "dependencies": {
    "alpinejs": "^3.15.12"
  }
}
